				    Source = Parquet.Document(File.Contents(DataFolder & "\dim_recipient.parquet")),
				    Selected = Table.SelectColumns(Source, {"recipient_uei", "recipient_name"}),
				    Typed = Table.TransformColumnTypes(
				        Selected,
				        {
				            {"recipient_uei", type text},
				            {"recipient_name", type text}
				        }
